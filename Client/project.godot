; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Control",
"class": "AttackJoystick",
"language": "GDScript",
"path": "res://Scenes/MainScenes/GameUI/Components/Game/Components/Joystick/Attack.gd"
}, {
"base": "Control",
"class": "MoveJoystick",
"language": "GDScript",
"path": "res://Scenes/MainScenes/GameUI/Components/Game/Components/Joystick/Move.gd"
}, {
"base": "Node",
"class": "Oauth2",
"language": "GDScript",
"path": "res://oauth.gd"
} ]
_global_script_class_icons={
"AttackJoystick": "",
"MoveJoystick": "",
"Oauth2": ""
}

[application]

config/name="Kingdom Crushers"
run/main_scene="res://SceneHandler.tscn"
boot_splash/image="res://Assets/ui/whitebg.png"
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://Assets/MMORealm.png"
config/quit_on_go_back=false

[autoload]

Animations="*res://Scenes/Singletons/Animations/Animations.tscn"
Server="*res://Scenes/Singletons/Server.gd"
Gateway="*res://Scenes/Singletons/Gateway.gd"
ClientData="*res://Data/ClientData.gd"
AudioHandler="*res://Scenes/Singletons/Misc/AudioHandler.gd"
AccountHandler="*res://Scenes/Singletons/Misc/AccountHandler.gd"
GameHandler="*res://Scenes/Singletons/Misc/GameHandler.gd"
SettingsHandler="*res://Scenes/Singletons/Misc/SettingsHandler.gd"
PlayBilling="*res://Scenes/Singletons/Misc/PlayBilling.gd"
UtilityFunctions="*res://Scenes/Singletons/Misc/UtilityFunctions.gd"
GameUI="*res://Scenes/MainScenes/GameUI/GameUI.tscn"

[debug]

settings/fps/force_fps=60

[display]

window/size/width=1920
window/size/height=1080
window/size/test_width=1920
window/size/test_height=1080
window/per_pixel_transparency/allowed=true
window/per_pixel_transparency/enabled=true
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/ProjectResolution/plugin.cfg" )

[global]

stretch=false
displa=false
port=false

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://Resources/main_theme.tres"

